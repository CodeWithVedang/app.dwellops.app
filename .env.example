# Copy to .env.local (never commit). Production values are injected by Vercel/Render.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/nivaso_plus
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/nivaso_plus
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/nivaso_plus_test
AUTH_SECRET=replace-with-32+-random-chars
NEXT_PUBLIC_APP_URL=http://localhost:3000
# File storage. Empty = production stores files in Postgres (file_blobs), dev under .storage/.
# Set STORAGE_PROVIDER=postgres to use Postgres in dev too. Fill the S3 vars (R2, AWS S3...) to use a bucket instead.
STORAGE_PROVIDER=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
EMAIL_API_KEY=
# Sender for Resend; unset in dev = emails print to the server console.
EMAIL_FROM=Nivaso Plus <no-reply@nivasoplus.app>
WHATSAPP_API_KEY=
# Protects /api/jobs/* for manual runs (Bearer token). Scheduled jobs run in the Render worker. 16+ random chars.
CRON_SECRET=
